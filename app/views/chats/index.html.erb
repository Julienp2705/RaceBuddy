<div class="my-container chats-page">
  <div class="chats-page-header">
  <div class="chats-page-title">
    <h1>Mes conversations</h1>
    <span class="chats-count">
      <i class="fa-solid fa-comments"></i>
      <%= @chats.count %>
    </span>
  </div>

  <p>Retrouve tes partenaires d'entraînement.</p>
</div>

  <div class="chats-list">
    <% @chats.each do |chat| %>
      <%= render "chats/chat_card", chat: chat, current_user: current_user %>
    <% end %>
  </div>
</div>
