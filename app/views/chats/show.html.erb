<div class="my-container" data-controller="chat-scroll">

  <!-- HEADER -->
  <%= link_to chats_path, class: "back-arrow" do %>
    <i class="fa-solid fa-arrow-left-long"></i>
  <% end %>

  <div class="chat-header">
    <h2>
      <%= @other_user.first_name %>
      <%= @other_user.last_name.first %>.
    </h2>

    <p class="chat-race-name">
      <%= @chat.invite.target.race.name %>
    </p>
  </div>

  <!-- MESSAGES -->
  <%= turbo_frame_tag "messages" do %>
    <%= render "messages/messages", messages: @messages, other_user: @other_user, chat: @chat, message: @message %>
  <% end %>

  <!-- FORMULAIRE -->
  <div class="chat-form">
    <% if @message.errors.any? %>
      <p class="text-danger"><%= @message.errors[:content].first %></p>
    <% end %>

    <%= form_with model: [@chat, @message],
        data: {
          controller: "reset-form",
          action: "turbo:submit-end->reset-form#reset",
        } do |f| %>

      <%= f.text_field :content,
          placeholder: "Écrire un message...",
          class: "form-control",
          autocomplete: "off" %>

      <%= button_tag type: "submit", class: "btn chat-send-button" do %>
        <i class="fa-solid fa-paper-plane"></i>
      <% end %>
    <% end %>
  </div>

  <div data-chat-scroll-target="bottom"></div>

</div>
