<div class="my-container">

  <!-- HEADER -->
  <%= link_to chats_path, class: "back-arrow" do %>
    <i class="fa-solid fa-arrow-left-long"></i>
  <% end %>
  <div class="chat-header">

    <div>
      <h2>
        <i class="fa-solid fa-flag-checkered"></i>
        <%= @chat.invite.target.race.name %> -
        <i class="fa-solid fa-user"></i>
        <%= @other_user.first_name %>
        <%= @other_user.last_name.first %>.
      </h2>
    </div>
  </div>


  <!-- MESSAGES -->

  <div class="chat-messages">

    <% @messages.each do |message| %>

      <div class="message <%= message.user == current_user ? "message-own" : "message-other" %>">

        <div class="message-bubble">

          <% unless message.user == current_user %>
            <div class="message-user">
              <%= message.user.first_name %>
              <%= @other_user.last_name.first %>.
            </div>
          <% end %>

          <div class="message-content-row">

            <div class="message-content">
              <%= message.content %>
            </div>

            <% if message.user == current_user %>
              <div class="message-actions">

                <button
                  type="button"
                  class="message-action"
                  data-bs-toggle="modal"
                  data-bs-target="#editMessageModal<%= message.id %>">
                  <i class="fa-solid fa-pen"></i>
                </button>

                <%= link_to chat_message_path(@chat, message),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Supprimer ce message ?"
                    },
                    class: "message-action message-delete" do %>
                  <i class="fa-solid fa-trash"></i>
                <% end %>

              </div>
            <% end %>

          </div>

          <% end %>

          <div class="message-time">
            <%= message.created_at.strftime("%H:%M") %>
          </div>

        </div>

      </div>
      <%= render "messages/edit_modal", message: message, edit_error: message.id == @message.id && @message.errors.any? %>
    <% end %>

  </div>


  <!-- FORMULAIRE -->

  <div class="chat-form">
    <% if @message.errors.any? %>
      <p class="text-danger">
        <%= @message.errors[:content].first %>
      </p>
    <% end %>

    <%= form_with model: [@chat, @message] do |f| %>

      <%= f.text_field :content,
          placeholder: "Écrire un message...",
          class: "form-control",
          autocomplete: "off" %>

      <%= button_tag type: "submit",
          class: "btn btn-1" do %>
        <i class="fa-solid fa-paper-plane"></i>
      <% end %>

    <% end %>

  </div>

</div>
