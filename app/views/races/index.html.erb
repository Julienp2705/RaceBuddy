<div class="my-container">
<!-- ########## TOGGLE SEARCH CARD ########## -->
  <div data-controller="toggle" class="toggle-card">
    <div class="card-toggle toggle-card__tabs">
      <button class="toggle-option toggle-card__tab <%= 'active' unless @race.errors.any? %>"
              data-action="toggle#show"
              data-toggle-index-param="0"
              data-toggle-target="option">Rechercher une course</button>
      <button class="toggle-option toggle-card__tab <%= 'active' if @race.errors.any? %>"
              data-action="toggle#show"
              data-toggle-index-param="1"
              data-toggle-target="option">Créer une course</button>
    </div>

    <div class="form-panel toggle-card__panel <%= 'active' unless @race.errors.any? %>" data-toggle-target="panel">
      <!-- search form -->
      <%= form_with url: races_path, method: :get, class: "race-search-form toggle-card__search-row" do |f| %>
        <i class="fa-solid fa-magnifying-glass toggle-card__search-icon"></i>
        <%= f.search_field :query,
        value: params[:query],
        placeholder: "Ex. Semi-marathon de Bordeaux",
        class: "form-control toggle-card__search-input" %>
        <%= button_tag type: "submit", class: "btn btn-1 btn-homepage toggle-card__search-submit" do %>
          <i class="fa-solid fa-arrow-right"></i>
        <% end %>
      <% end %>
      <!--
      <div class="toggle-card__chips">
        <button type="button" class="toggle-card__chip active">5k</button>
        <button type="button" class="toggle-card__chip">10k</button>
        <button type="button" class="toggle-card__chip">Semi</button>
        <button type="button" class="toggle-card__chip">Marathon</button>
      </div>
      -->
    </div>
    <div class="form-panel toggle-card__panel <%= 'active' if @race.errors.any? %>" data-toggle-target="panel">
      <!-- create form -->
      <%= simple_form_for @race do |f| %>
        <%= f.input :name,
            label: false,
            placeholder: "Nom de la course" %>
        <%= f.input :distance,
            label: false,
            placeholder: "Distance (km)" %>
        <div class="toggle-card__date-field">

          <%= f.date_select :race_date,
              { order: [:day, :month, :year],
                start_year: Date.current.year,
                end_year: Date.current.year + 3 },
              { class: "form-select" } %>
        </div>
        <%= f.input :url,
            label: false,
            placeholder: "Lien de la course" %>
        <%= f.button :submit,
            "Créer ma course",
            class: "btn-1 w-100 btn-homepage" %>
      <% end %>
    </div>
  </div>

<!-- ########## RACES LIST ########## -->
  <div class="races-grid">
  <% @races.each do |race| %>
      <div class="race-carousel-card">
        <div class="race-carousel-card__image-wrap">
          <% if race.image.attached? %>
            <%= image_tag race.image, class: "race-carousel-card__image" %>
          <% else %>
            <%= image_tag race_category_image(race.distance), class: "race-carousel-card__image" %>
          <% end %>
          <span class="race-carousel-card__badge"><%= race_category_label(race.distance) %></span>
        </div>
        <div class="race-carousel-card__body">
          <div class="race-carousel-card__row">
            <span class="race-carousel-card__distance"><%= race.distance %> km</span>
            <%= link_to "Voir la course", race_path(race), class: "btn-2 rejoindre", data: { turbo_frame: "_top" } %>
          </div>
          <h3 class="race-carousel-card__title"><%= race.name %></h3>
          <p class="race-carousel-card__date"><i class="fa-regular fa-calendar"></i> <%= l(race.race_date, format: :long) %></p>
        </div>
      </div>
    <% end %>
  </div>
</div>
