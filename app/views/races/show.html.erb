<div class="race-show-container">

  <div class="race-info-card">
    <h1><%= @race.name %></h1>
    <p class="race-distance"><%= @race.distance %> km</p>
    <a href="<%= @race.url %>" target="_blank" rel="noopener noreferrer" class="race-link">Plus d'infos</a>

    <% if @target %>
      <span class="badge-cta">Objectif enregistré ✓</span>
    <% else %>
      <%= link_to "Créer un objectif", new_race_target_path(@race), class: "btn-2" %>
    <% end %>
  </div>

  <% if @target %>
    <div class="race-map"
      data-controller="map"
      data-map-lat-value="<%= @target.latitude %>"
      data-map-lng-value="<%= @target.longitude %>">
    </div>

    <div class="buddies-section">
      <h2>Buddies disponibles</h2>
      <% @buddies.each do |buddy| %>
        <%= link_to buddy_path(buddy.user) do %>
          <div class="buddy-card">
            <div class="avatar">
              <% if buddy.user.avatar.attached? %><%= image_tag buddy.user.avatar %><% else %><% end %>
            </div>
            <div>
              <strong><%= buddy.user.first_name %> <%= buddy.user.last_name %></strong>
              <p><%= buddy.address %> · <%= buddy.target_hour %>:<%= buddy.target_minute %></p>
            </div>
            <div>
              <p>⭐️⭐️⭐️⭐️⭐️</p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

</div>
