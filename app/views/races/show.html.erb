<div class="race-show-container">

  <div class="race-info-card">
    <h1><%= @race.name %></h1>
    <p class="race-distance"><%= @race.distance %> km</p>
    <a href="<%= @race.url %>" target="_blank" rel="noopener noreferrer" class="race-link">Plus d'infos</a>

    <% if @target %>
      <span class="badge-cta">Objectif enregistré ✓</span>
    <% else %>
      <%= link_to "Créer un objectif", new_race_target_path(@race), class: "btn-2" %>
    <% end %>
  </div>

  <div class="race-map-placeholder">
    <p>🗺️ Carte à venir</p>
  </div>

  <% if @target %>
    <div class="buddies-section">
      <h2>Buddies disponibles</h2>
      <!-- placeholder cards — swap for real @buddies loop later -->
      <div class="buddy-card-placeholder">
        <div class="avatar-placeholder"></div>
        <div>
          <strong>Nom du buddy</strong>
          <p>Ville · Objectif similaire</p>
        </div>
      </div>
      <div class="buddy-card-placeholder">
        <div class="avatar-placeholder"></div>
        <div>
          <strong>Nom du buddy</strong>
          <p>Ville · Objectif similaire</p>
        </div>
      </div>
    </div>
  <% end %>

</div>
