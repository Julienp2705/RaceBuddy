<div class="chat-messages" id="chat-messages">

      <% messages.each do |mes| %>
        <% mine = mes.user == viewer %>

        <div class="message-row <%= mine ? "message-row-mine" : "message-row-other" %>">
          <% unless mine %>
            <%= link_to buddy_path(other_user), data: { turbo_frame: "_top" } do %>
              <div class="chat-card-avatar">
                <% if other_user.avatar.attached? %>
                  <%= image_tag other_user.avatar %>
                <% else %>
                  <span><%= other_user.first_name.first %><%= other_user.last_name.first %></span>
                <% end %>
                <i class="fa-solid fa-eye"></i>
              </div>
            <% end %>
          <% end %>
          <div class="message-wrapper">

            <div class="message-bubble">

              <div class="message-content">
                <%= mes.content %>
              </div>

            </div>
            <% if !mine %>
              <div class="message-time">
                <%= mes.created_at.strftime("%H:%M") %>
              </div>
            <% end %>
            <% if mine %>
              <div class="message-actions">
                <button
                  type="button"
                  class="message-action"
                  data-bs-toggle="modal"
                  data-bs-target="#editMessageModal<%= mes.id %>">
                  <i class="fa-solid fa-pencil"></i>
                </button>

                <%= link_to chat_message_path(chat, mes),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Supprimer ce message ?"
                    },
                    class: "message-action message-delete" do %>
                  <i class="fa-regular fa-trash-can"></i>
                <% end %>
              </div>
            <% end %>
          </div>

        </div>
        <% errored = message&.id == mes.id && message.errors.any? %>
        <%= render "messages/edit_modal",
            message: errored ? message : mes,
            chat: mes.chat,
            edit_error: errored %>
        <% end %>
</div>
