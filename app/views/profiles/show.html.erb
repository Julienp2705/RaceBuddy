<div class="profile-container main">

  <!-- SECTION PROFIL -->
  <section class="profile-header">
    <div class="profile-avatar">
      <%= image_tag "profile-placeholder.jpg", alt: "Photo de profil" %>
    </div>

    <h1><%= @user.first_name %></h1>

    <div class="profile-stats">

      <div class="profile-stat">
        <p>NOTE</p>
        <p>★★★★★</p>
      </div>

      <div class="profile-stat">
        <p>👥 6</p>
        <p>Buddies</p>
      </div>

    </div>
  </section>


  <!-- SECTION OBJECTIF EN COURS -->
<section class="profile-section">
  <h2>Mon objectif en cours</h2>

  <% if @target.present? %>

    <div class="race-card" data-controller="target-edit">

      <div class="race-image">
        <%= image_tag "race-placeholder.jpg", alt: "Course" %>
      </div>

      <div class="race-content">

        <p>
          🎯 Objectif :
          <%= @target.target_hour %>h<%= format("%02d", @target.target_minute) %>
        </p>

        <div class="target-actions">

          <button
            type="button"
            class="btn btn-primary target-btn"
            data-action="click->target-edit#show">
            Modifier
          </button>

          <%= link_to "Supprimer",
              buddy_target_path(@user, @target),
              method: :delete,
              data: {
                turbo_method: :delete,
                turbo_confirm: "Voulez-vous vraiment supprimer cet objectif ?"
              },
              class: "btn btn-outline-danger target-btn" %>

        </div>

        <div class="target-form d-none" data-target-edit-target="form">

          <%= simple_form_for @target,
              url: buddy_target_path(@user, @target),
              method: :patch do |f| %>

            <div class="target-time-inputs">
              <%= f.input :target_hour, label: "Heures" %>
              <%= f.input :target_minute,
                          label: "Minutes",
                          input_html: { min: 0, max: 59, step: 5 } %>
            </div>

            <%= f.submit "Enregistrer", class: "btn btn-primary" %>

          <% end %>

        </div>

      </div>

    </div>

  <% else %>

    <div class="profile-box">
    <p>Aucun objectif en cours.</p>
  </div>

  <% end %>
</section>


  <!-- SECTION COURSES TERMINÉES -->
  <section class="profile-section">
    <h2>Courses terminées</h2>

    <div class="race-card">

      <div class="race-image">
        <%= image_tag "race-placeholder.jpg", alt: "Course" %>
      </div>

      <div class="race-content">
        <h3>HOKA 10k Paris</h3>

        <p>
          Quelques informations sur la course...
        </p>

        <p>🏃 10 km</p>
      </div>

    </div>


    <div class="race-card">

      <div class="race-image">
        <%= image_tag "race-placeholder.jpg", alt: "Course" %>
      </div>

      <div class="race-content">
        <h3>Ventoux BY UTMB</h3>

        <p>
          Quelques informations sur la course...
        </p>

        <p>🏃 50 km</p>
      </div>

    </div>

  </section>

</div>
