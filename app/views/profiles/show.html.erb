<div class="profile-container main">

  <!-- SECTION PROFIL -->
  <section class="profile-header">
    <div class="profile-avatar">
      <%= image_tag "profile-placeholder.jpg", alt: "Photo de profil" %>
    </div>

    <h1><%= @user.first_name %></h1>

    <div class="profile-stats">

      <div class="profile-stat">
        <p>NOTE</p>
        <p>★★★★★</p>
      </div>

      <div class="profile-stat">
        <p>👥 6</p>
        <p>Buddies</p>
      </div>

    </div>
  </section>


  <!-- SECTION DESCRIPTION -->
  <section class="profile-section">
    <h2>Ma Description</h2>

    <div class="profile-box">
      <p>
        Coureur passionné, je cherche des buddies pour mes prochaines courses.
      </p>
    </div>
  </section>


  <!-- SECTION VILLE -->
  <section class="profile-section">
    <h2>Ma Ville d'entraînement</h2>

    <div class="profile-box">
      <p>Lille</p>
    </div>
  </section>

  <h2>Invitations en attente (<%= @pending_invites.size %>)</h2>

  <% if @pending_invites.empty? %>
    <p class="text-muted">Aucune invitation pour le moment.</p>
  <% else %>
    <ul class="list-group">
      <% @pending_invites.each do |invite| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <strong><%= invite.user.first_name %></strong> — <%= invite.target.race.name %>
            <div class="text-muted small"><%= time_ago_in_words(invite.created_at) %></div>
          </div>

          <button type="button"
                  class="btn btn-outline-primary btn-sm"
                  data-bs-toggle="modal"
                  data-bs-target="#invite-<%= invite.id %>">
            Voir l'invitation
          </button>
        </li>

        <%= render "shared/modal", invite: invite %>
      <% end %>
    </ul>
  <% end %>

  <!-- SECTION OBJECTIF EN COURS -->
<section class="profile-section">
  <h2>Mon objectif en cours</h2>

    <% if @current_target.nil? %>
      <p class="text-muted">Aucun objectif en cours.</p>
    <% else %>
      <div class="race-card">
        <div class="race-image">
          <%= image_tag "race-placeholder.jpg", alt: @current_target.race.name %>
        </div>

        <div class="race-content">
          <h3><%= @current_target.race.name %></h3>
          <p>🏃 <%= @current_target.race.distance %> km</p>
          <p>🎯 <%= @current_target.target_hour %>h<%= format("%02d", @current_target.target_minute) %></p>
           <div class="target-actions">

          <button
            type="button"
            class="btn btn-primary target-btn"
            data-action="click->target-edit#show">
            Modifier
          </button>

          <%= link_to "Supprimer",
              buddy_target_path(@user, @target),
              method: :delete,
              data: {
                turbo_method: :delete,
                turbo_confirm: "Voulez-vous vraiment supprimer cet objectif ?"
              },
              class: "btn btn-outline-danger target-btn" %>

          </div>
        </div>
      </div>
    <% end %>
  </section>


  <!-- SECTION COURSES TERMINÉES -->
  <section class="profile-section">
    <h2>Mes précédents objectifs</h2>

    <% if @past_targets.empty? %>
      <p class="text-muted">Aucun objectif précédent.</p>
    <% else %>
      <% @past_targets.each do |target| %>
        <div class="race-card">
          <div class="race-image">
            <%= image_tag "race-placeholder.jpg", alt: target.race.name %>
          </div>

          <div class="race-content">
            <h3><%= target.race.name %></h3>
            <p>🏃 <%= target.race.distance %> km</p>
            <p>🎯 <%= target.target_hour %>h<%= format("%02d", target.target_minute) %></p>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
