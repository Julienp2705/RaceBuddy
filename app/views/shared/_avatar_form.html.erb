<%= form_with model: user, url: profile_path, method: :patch do |f| %>

  <% if user.errors[:avatar].any? %>
    <p class="avatar-modal-error" role="alert">
      <i class="fa-solid fa-circle-exclamation"></i>
      <%= user.errors[:avatar].join(", ") %>
    </p>
  <% end %>

  <!-- Aperçu de la photo actuelle -->
  <div class="profile-avatar">
    <%= image_tag user.avatar_url, alt: "Photo de profil actuelle" %>
  </div>

  <!-- Le champ fichier est masqué : c'est le label qui sert de bouton -->
  <%= f.label :avatar, class: "btn btn-3 avatar-modal-choose" do %>
    <i class="fa-regular fa-image"></i>
    Choisir une image
  <% end %>

  <%= f.file_field :avatar,
        accept: "image/png,image/jpeg,image/webp",
        class: "avatar-modal-input" %>

  <div class="avatar-modal-confirm">
    <%= f.submit "Enregistrer", class: "btn btn-2 avatar-modal-submit" %>
  </div>
<% end %>

<!-- Hors du form_with : button_to génère son propre formulaire -->
<% if user.avatar.attached? %>
  <%= button_to profile_path,
        method: :patch,
        params: { remove_avatar: true },
        class: "avatar-modal-remove",
        form: { data: { turbo_confirm: "Supprimer votre photo de profil ?" } } do %>
    <i class="fa-solid fa-trash"></i>
    Supprimer la photo actuelle
  <% end %>
<% end %>
