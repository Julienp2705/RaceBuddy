<nav class="navbar navbar-expand-lg rb-navbar sticky-top">
  <div class="container">
    <%= link_to "/", class: "navbar-brand" do %>
      Race<span class="rb-brand-dot">Buddy</span>
    <% end %>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#rbNav"
      aria-controls="rbNav"
      aria-expanded="false"
      aria-label="Ouvrir la navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="rbNav">
      <ul class="navbar-nav ms-auto align-items-lg-center">

        <li class="nav-item">
          <%= link_to "/", class: "nav-link #{'active' if current_page?(root_path)}" do %>
            <i class="fa-solid fa-house"></i>
          <% end %>
        </li>

        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to profile_path, class: "nav-link #{'active' if current_page?(profile_path)}" do %>
              <i class="fa-solid fa-circle-user"></i>
            <% end %>
          </li>

          <li class="nav-item">
            <%= link_to chats_path, class: "nav-link #{'active' if current_page?(chats_path)}" do %>
              <i class="fa-regular fa-comments"></i>
            <% end %>
          </li>
        <% end %>

        <li class="nav-item dropdown">
          <img
            class="avatar dropdown-toggle"
            id="navbarDropdown"
            data-bs-toggle="dropdown"
            aria-haspopup="true"
            aria-expanded="false"
            src="https://kitt.lewagon.com/placeholder/users/ssaunier"
            alt="Menu utilisateur"
          >

          <div
            class="dropdown-menu dropdown-menu-end"
            aria-labelledby="navbarDropdown"
          >
            <% if user_signed_in? %>
              <%= link_to "Se déconnecter",
                  destroy_user_session_path,
                  data: { turbo_method: :delete },
                  class: "dropdown-item" %>
            <% else %>
              <%= link_to "Se connecter",
                  new_user_session_path,
                  class: "dropdown-item" %>

              <%= link_to "S'inscrire",
                  new_user_registration_path,
                  class: "dropdown-item" %>
            <% end %>
          </div>
        </li>

      </ul>
    </div>
  </div>
</nav>
