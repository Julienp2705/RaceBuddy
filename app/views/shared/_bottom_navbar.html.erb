<nav class="bottom-navbar" data-controller="bottom-navbar">
  <span class="bottom-navbar__pill" data-bottom-navbar-target="pill" aria-hidden="true"></span>

  <%= link_to root_path, class: "bottom-navbar__item #{'bottom-navbar__item--active' if current_page?(root_path)}", data: { "bottom-navbar-target": "item" } do %>
  <i class="fa-solid fa-house"></i>
  <span>Accueil</span>
  <% end %>

  <%= link_to chats_path, class: "bottom-navbar__item #{'bottom-navbar__item--active' if current_page?(chats_path)}", data: { "bottom-navbar-target": "item" } do %>
  <i class="fa-solid fa-comments"></i>
  <span>Messages</span>
  <span id="nav-unread-badge">
    <% if user_signed_in? %>
      <%= render "shared/unread_badge", user: current_user %>
    <% end %>
  </span>
  <% end %>

  <%= link_to profile_path, class: "bottom-navbar__item #{'bottom-navbar__item--active' if current_page?(profile_path)}", data: { "bottom-navbar-target": "item" } do %>
  <i class="fa-solid fa-user"></i>
  <span>Profil</span>
  <% end %>

  <%= link_to races_path, class: "bottom-navbar__item #{'bottom-navbar__item--active' if current_page?(races_path)}", data: { "bottom-navbar-target": "item" } do %>
  <i class="fa-solid fa-magnifying-glass"></i>
  <span>Courses</span>
  <% end %>
</nav>
