<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light only">
    <meta name="supported-color-schemes" content="light only">
    <title>RaceBuddy</title>
    <style>
      body { margin: 0; padding: 0; width: 100% !important; }
      table { border-collapse: collapse; }
      img { border: 0; line-height: 100%; outline: none; text-decoration: none; }
      a { color: #415A77; }
      @media only screen and (max-width: 600px) {
        .rb-pad { padding-left: 24px !important; padding-right: 24px !important; }
        .rb-h1 { font-size: 24px !important; }
      }
    </style>
  </head>

  <body style="margin:0; padding:0; background-color:#F8F9FA;">
    <span style="display:none; font-size:1px; color:#F8F9FA; max-height:0; max-width:0; opacity:0; overflow:hidden;">
      <%= yield :preheader %>
    </span>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#F8F9FA;">
      <tr>
        <td align="center" style="padding:32px 16px;">

          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">

            <tr>
              <td style="padding:0 0 24px;">
                <span style="font-family:Helvetica,Arial,sans-serif; font-size:18px; font-weight:700; letter-spacing:-0.01em; color:#1B263B;">RaceBuddy</span>
              </td>
            </tr>

            <tr>
              <td style="background-color:#ffffff; border:1px solid #E0E1DD; border-radius:12px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td height="4" style="background-color:#E76F51; border-radius:12px 12px 0 0; font-size:0; line-height:0;">&nbsp;</td>
                  </tr>
                  <tr>
                    <td class="rb-pad" style="padding:40px;">
                      <%= yield %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:24px 8px 0; font-family:Helvetica,Arial,sans-serif; font-size:13px; line-height:1.6; color:#444844;">
                Tu reçois cet e-mail parce qu'un compte RaceBuddy est associé à cette adresse.<br>
                <a href="https://www.racebuddy.me" style="color:#415A77;">racebuddy.me</a>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
