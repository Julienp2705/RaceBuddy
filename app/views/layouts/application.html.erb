<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "RaceBuddy — Trouve ton partenaire d'entraînement" %></title>
    <%= render "shared/meta" %>
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "RaceBuddy met en relation les coureurs qui préparent la même course. Trouve un binôme d'entraînement près de chez toi." %>">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="application-name" content="Race Buddy">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="mapbox-token" content="<%= ENV.fetch("MAPBOX_ACCESS_TOKEN") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>


<%= favicon_link_tag "favicon.ico" %>
<%= favicon_link_tag "favicon.svg", rel: "icon", type: "image/svg+xml" %>
<%= favicon_link_tag "apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png" %>


    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link href="https://api.mapbox.com/mapbox-gl-js/v3.0.0/mapbox-gl.css" rel="stylesheet">
  </head>

  <body>
    <%= render "shared/top_header" %>      <%# mobile only %>
    <%= render "shared/flashes" %>
    <% if user_signed_in? %>
      <%= turbo_stream_from current_user %>
    <% end %>
    <%= yield %>
    <%= render "shared/bottom_navbar" %>   <%# mobile only, fixed to bottom %>
  </body>
</html>
