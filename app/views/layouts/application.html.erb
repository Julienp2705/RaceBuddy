<!DOCTYPE html>
<html>
  <head>
    <title>Race Buddy - Trouve le partenaire idéal pour atteindre tes objectifs de course</title>

    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Race Buddy">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="mapbox-token" content="<%= ENV.fetch("MAPBOX_ACCESS_TOKEN") %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">


    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link href="https://api.mapbox.com/mapbox-gl-js/v3.0.0/mapbox-gl.css" rel="stylesheet">
  </head>

  <body>
    <%= render "shared/top_header" %>      <%# mobile only %>
    <%= render "shared/flashes" %>
    <%= yield %>
    <%= render "shared/bottom_navbar" %>   <%# mobile only, fixed to bottom %>
  </body>
</html>
