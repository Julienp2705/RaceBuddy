<div class="container">

<h1><%= @race.name %></h1>
<div class="container">

<%= simple_form_for [@race, @target] do |f| %>
  <h3>Temps cible</h3>
  <p class="form-hint">Le temps que tu vises pour terminer la course</p>
  <%= f.input :target_hour,
      collection: 0..23,
      label: "Heures" %>

  <%= f.input :target_minute,
      collection: [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55],
      label: "Minutes" %>

  <%= f.input :address,
      label: "Ville d'entraînement", placeholder:"ex: Bordeaux, France OU 67100"%>

  <%= f.button :submit, "Enregistrer l'objectif" %>
<% end %>
</div>
</div>
