<div
  class="modal fade"
  id="article-<%= id %>"
  aria-labelledby="articleModalLabel-<%= id %>"
  tabindex="-1"
  aria-hidden="true">

  <div class="modal-dialog">
    <div class="modal-content">

      <div class="modal-header">
        <h2 class="modal-title" id="articleModalLabel-<%= id %>">
          <i class="fa-solid <%= icon %>"></i>
          <%= title %>
        </h2>

        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close">
        </button>
      </div>

      <div class="modal-body">
        <p><%= body %></p>
      </div>

    </div>
  </div>
</div>
