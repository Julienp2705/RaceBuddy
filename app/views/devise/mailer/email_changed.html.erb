<% content_for :preheader, "L'adresse e-mail de ton compte RaceBuddy a changé." %>

<h1 class="rb-h1" style="margin:0 0 16px; font-family:Helvetica,Arial,sans-serif; font-size:28px; font-weight:700; line-height:1.2; letter-spacing:-0.02em; color:#1B263B;">
  Adresse e-mail modifiée
</h1>

<p style="margin:0; font-family:Helvetica,Arial,sans-serif; font-size:16px; line-height:1.6; color:#444844;">
  <% if @resource.try(:unconfirmed_email?) %>

    Un changement d'adresse est en cours sur ton compte : <strong style="color:#1B263B;"><%= @resource.unconfirmed_email %></strong>.
    Il prendra effet une fois la nouvelle adresse confirmée.

  <% else %>

    L'adresse de ton compte est désormais <strong style="color:#1B263B;"><%= @resource.email %></strong>.

  <% end %>
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:32px 0 0;">
  <tr>
    <td style="padding:16px; background-color:#F8F9FA; border-left:3px solid #E76F51; border-radius:0 10px 10px 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; line-height:1.6; color:#444844;">
      Tu n'es pas à l'origine de ce changement ? Contacte-nous immédiatement à
      <a href="mailto:contact@racebuddy.me" style="color:#415A77;">contact@racebuddy.me</a>.
    </td>
  </tr>
</table>
