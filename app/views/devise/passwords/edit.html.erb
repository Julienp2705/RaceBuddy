<%# Choix du nouveau mot de passe %>

<div class="devise-page">
  <aside class="devise-aside">
    <p class="devise-aside__brand">RaceBuddy</p>

    <div>
      <p class="devise-aside__pitch">
        Dernière ligne <em>droite</em>.
      </p>
      <ul class="devise-aside__points">
        <li>Choisis un mot de passe long plutôt que compliqué</li>
        <li>Une phrase de plusieurs mots vaut mieux qu'un mot tordu</li>
        <li>Tu seras connecté automatiquement ensuite</li>
      </ul>
    </div>

    <p class="devise-aside__footnote">
      Ce lien ne fonctionne qu'une seule fois. Garde cet onglet ouvert jusqu'à la validation.
    </p>
  </aside>

  <main class="devise-main">
    <div class="devise-card">
      <p class="devise-card__brand">RaceBuddy</p>

      <p class="devise-card__eyebrow">Réinitialisation</p>
      <h1 class="devise-card__title">Ton nouveau mot de passe</h1>
      <p class="devise-card__subtitle">
        Choisis un mot de passe d'au moins <%= @minimum_password_length || Devise.password_length.min %> caractères.
      </p>

      <% if resource.errors.any? %>
        <div class="devise-errors" role="alert">
          <p class="devise-errors__title">
            <%= pluralize(resource.errors.count, "erreur") %> à corriger :
          </p>
          <ul class="devise-errors__list">
            <% resource.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: resource,
                    scope: resource_name,
                    url: password_path(resource_name),
                    html: { method: :put },
                    class: "devise-form" do |f| %>

        <%= f.hidden_field :reset_password_token %>

        <div class="devise-field">
          <%= f.label :password, "Nouveau mot de passe", class: "devise-field__label" %>
          <%= f.password_field :password,
                autofocus: true,
                autocomplete: "new-password",
                required: true,
                minlength: (@minimum_password_length || Devise.password_length.min),
                class: "devise-field__input",
                "aria-invalid": resource.errors[:password].any?.to_s %>

          <% if resource.errors[:password].any? %>
            <p class="devise-field__error">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 1a7 7 0 100 14A7 7 0 008 1zm0 3.25a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0V5a.75.75 0 01.75-.75zM8 11.75a.9.9 0 110-1.8.9.9 0 010 1.8z" />
              </svg>
              <span><%= resource.errors[:password].join(", ") %></span>
            </p>
          <% end %>
        </div>

        <div class="devise-field">
          <%= f.label :password_confirmation, "Confirme le mot de passe", class: "devise-field__label" %>
          <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                required: true,
                class: "devise-field__input",
                "aria-invalid": resource.errors[:password_confirmation].any?.to_s %>

          <% if resource.errors[:password_confirmation].any? %>
            <p class="devise-field__error">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M8 1a7 7 0 100 14A7 7 0 008 1zm0 3.25a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0V5a.75.75 0 01.75-.75zM8 11.75a.9.9 0 110-1.8.9.9 0 010 1.8z" />
              </svg>
              <span><%= resource.errors[:password_confirmation].join(", ") %></span>
            </p>
          <% end %>
        </div>

        <%= f.submit "Enregistrer et me connecter", class: "devise-btn" %>
      <% end %>

      <p class="devise-footer">
        Lien expiré ?
        <%= link_to "Demander un nouveau lien", new_password_path(resource_name), class: "devise-link" %>
      </p>
    </div>
  </main>
</div>
